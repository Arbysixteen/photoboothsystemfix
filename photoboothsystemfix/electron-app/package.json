{
  "name": "photobooth-Friplus",
  "version": "2.0.0",
  "description": "Photobooth System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --enable-logging",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.friplus.photobooth",
    "productName": "FRIPLUS PHOTOBOX POTRAIT FIX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "captures/",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "keywords": [
    "photobooth",
    "electron",
    "dslr",
    "kiosk"
  ],
  "author": "Photobooth Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "qrcode": "^1.5.4"
  }
}
